:443 {
    tls internal
    header Content-Type text/html
    respond `<!DOCTYPE html>
<html>
<head><title>Caddy</title></head>
<body style="font-family: system-ui; text-align: center; padding: 4rem;">
  <h1>Caddy Reverse Proxy</h1>
